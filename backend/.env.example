# --- required ---
MONGO_URI=mongodb://127.0.0.1:27017/skillsetu_local
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# --- admin account created on first start ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password
ADMIN_NAME=Administrator
ADMIN_PIC_URL=https://example.com/admin-profile.png

# --- server ---
PORT=5000
FRONTEND_URL=http://localhost:5173
# FRONTEND_URLS=https://app.example.com,https://www.example.com
# BACKEND_URL=http://localhost:5000
# MONGO_FALLBACK_URI=

# --- AI models (override when Google renames a model) ---
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# --- RAG tuning ---
# RAG_AUTO_SEED=true
# RAG_TOP_K=3
# RAG_SIMILARITY_THRESHOLD=0.65
# RAG_MAX_CANDIDATES=150
# RAG_KEYWORD_WEIGHT=0.25
# MATCH_MAX_CANDIDATES=500
